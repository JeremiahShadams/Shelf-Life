# Backend base URL.
#
# Leave unset during local development: the app derives the host from the Expo
# dev server (Constants.expoConfig.hostUri), so Expo Go on a physical phone
# connects to the machine running the backend automatically.
#
# Set it for production / standalone builds, or when the backend lives on a
# different host than the dev server:
# EXPO_PUBLIC_API_URL=https://api.your-domain.com
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8000
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_USE_RN_FETCH=1
