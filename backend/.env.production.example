# =============================================================================
# FRESCO Backend — Production Environment Configuration Template
# =============================================================================
# Copy to .env or configure in your cloud host (Railway, Render, AWS, Fly.io)
# =============================================================================

# Application
APP_NAME=FRESCO
APP_VERSION=1.0.0
DEBUG=False

# Security (Generate with: openssl rand -hex 32)
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days

# Database (PostgreSQL / Supabase / AWS RDS)
DATABASE_URL=postgresql+asyncpg://user:password@db.example.com:5432/fresco_prod

# CORS (Allow mobile app origins and production domain)
ALLOWED_ORIGINS=https://app.frescoapp.com,https://api.frescoapp.com

# Cloud Object Storage (Cloudflare R2 or AWS S3)
STORAGE_BACKEND=s3
S3_BUCKET=fresco-produce-uploads
S3_REGION=auto
S3_ACCESS_KEY_ID=your-s3-or-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-or-r2-secret-access-key
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_PUBLIC_URL=https://cdn.frescoapp.com

# Model artifact paths
CLASSIFIER_MODEL_PATH=models/fresco_model.keras
FRESHNESS_MODEL_PATH=models/fresco_model.keras
